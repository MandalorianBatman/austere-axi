{
  "name": "austere-axi",
  "version": "0.17.0",
  "description": "Agent-authored review artifacts in OpenUI Lang: a few hundred tokens instead of a whole HTML page, with statement-level annotations fed back to the agent.",
  "keywords": [
    "agent",
    "artifacts",
    "axi",
    "cli",
    "openui",
    "review"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MandalorianBatman/austere-axi.git"
  },
  "bin": {
    "austere-axi": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills",
    "types",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./pack": {
      "types": "./types/pack.d.ts"
    },
    "./catalog": {
      "types": "./types/catalog.d.ts"
    },
    "./pack-kit": {
      "types": "./types/pack-kit.d.ts"
    },
    "./sync": {
      "types": "./types/sync.d.ts",
      "default": "./dist/sync.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "pretest": "node scripts/build.ts spec sync",
    "test": "node --test test/*.test.ts",
    "test:browser": "node scripts/build.ts packs runtime spec chrome && node --test test/browser/*.test.ts",
    "signatures": "node scripts/signatures.ts",
    "gallery": "node scripts/gallery.ts",
    "site": "node scripts/site.ts",
    "shot": "node scripts/shot.ts",
    "demo": "node scripts/demo.ts",
    "social": "node scripts/social.ts",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bench": "node scripts/build.ts && npm --prefix bench ci --no-audit --no-fund && node bench/run.ts",
    "bench:report": "node bench/report.ts",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "cn": "^0.5.2"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^7.0.8",
    "@openuidev/lang-core": "^1.0.1",
    "@openuidev/react-headless": "^0.18.1",
    "@openuidev/react-lang": "^1.0.1",
    "@openuidev/react-ui": "^0.18.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.18.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.575.0",
    "marked": "^18.2.1",
    "next-themes": "^0.4.6",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.33",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7",
    "zustand": "^4.5.7"
  },
  "engines": {
    "node": ">=22.18"
  },
  "mcpName": "io.github.MandalorianBatman/austere-axi"
}
