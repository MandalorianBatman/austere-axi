{
  "compilerOptions": {
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "austere-axi/*": ["./types/*.d.ts"],
      "@/chrome/ui/*": ["./src/chrome/ui/*.tsx"],
      "@/chrome/lib/*": ["./src/chrome/lib/*.ts"],
      "@/chrome/hooks/*": ["./src/chrome/hooks/*.ts"]
    }
  },
  "include": [
    "src",
    "packs/*/src",
    "scripts",
    "action",
    "bench/*.ts",
    "bench/lib",
    "site",
    "test",
    "types"
  ]
}
