{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "no-control-regex": "off",
    "no-unsafe-finally": "off",
    "no-unused-expressions": "off",
    "no-unused-vars": "off",
    "react/refs": "off"
  },
  "ignorePatterns": [
    "src/chrome/ui",
    "src/chrome/hooks",
    "dist",
    "_site",
    "scratch",
    ".dev",
    "test/fixtures",
    "docs/*.gif"
  ]
}
